#!/usr/bin/env python3
"""Import Kubernetes audit-log JSON/JSONL events into compiler artifacts.

Usage:
    ./import_kubernetes_audit audit.jsonl --policy policy.json | ./compile - --gaps

The importer maps pod exec, deployment, and authorization-relevant audit events
into parsed action and tool-call artifacts. Authorization evidence is emitted
only when --policy is supplied.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
from typing import Any

from importer_common import (
    authorization_decision_id_from_fields,
    authorization_from_policy,
    first_present,
    load_json_or_jsonl,
    load_policy,
    nested_get,
    require_str,
    require_timestamp,
    write_artifacts,
)


def _resource_name(event: dict[str, Any]) -> str:
    ref = event.get("objectRef") if isinstance(event.get("objectRef"), dict) else {}
    resource = first_present(ref.get("resource"), ref.get("apiGroup"), "unknown_resource")
    namespace = ref.get("namespace")
    name = ref.get("name")
    subresource = ref.get("subresource")
    parts = [str(resource)]
    if namespace:
        parts.append(str(namespace))
    if name:
        parts.append(str(name))
    if subresource:
        parts.append(str(subresource))
    return "/".join(parts)


def _is_action_event(event: dict[str, Any]) -> bool:
    verb = str(event.get("verb", "")).lower()
    resource = str(nested_get(event, "objectRef", "resource") or "").lower()
    subresource = str(nested_get(event, "objectRef", "subresource") or "").lower()
    if verb in {"create", "update", "patch", "delete"}:
        return True
    if resource == "pods" and subresource in {"exec", "attach", "portforward"}:
        return True
    return bool(event.get("auditID") and verb)


def _event_to_artifacts(event: dict[str, Any], policy: dict[str, Any] | None, executed_at_override: str | None) -> dict[str, Any]:
    action_id_raw = first_present(event.get("auditID"), event.get("requestUID"))
    if action_id_raw is None:
        raise ValueError("missing required auditID")
    action_id = str(action_id_raw)
    verb = require_str(event.get("verb"), "verb")
    executed_at = require_timestamp(
        first_present(
            executed_at_override,
            event.get("requestReceivedTimestamp"),
            event.get("stageTimestamp"),
            event.get("timestamp"),
        ),
        "audit event",
    )
    resource = _resource_name(event)
    tool_name = f"kubernetes.{verb}.{resource}"
    decision = first_present(
        nested_get(event, "annotations", "authorization.k8s.io/decision"),
        nested_get(event, "annotations", "authorization.k8s.io/reason"),
        nested_get(event, "responseStatus", "code"),
    )
    annotations = event.get("annotations") if isinstance(event.get("annotations"), dict) else {}
    decision_id = authorization_decision_id_from_fields(event, annotations)
    invocation_context = {
        "source": "kubernetes_audit",
        "user": nested_get(event, "user", "username"),
        "groups": nested_get(event, "user", "groups"),
        "namespace": nested_get(event, "objectRef", "namespace"),
        "response_code": nested_get(event, "responseStatus", "code"),
    }
    if decision_id is not None:
        invocation_context["decision_id"] = str(decision_id)
    return {
        **authorization_from_policy(policy),
        "parsed_actions": [
            {
                "action_id": action_id,
                "tool": tool_name,
                "executed_at": executed_at,
                "source_kind": "kubernetes_audit",
                "parameters": {
                    "verb": verb,
                    "resource": resource,
                    "uri": event.get("requestURI"),
                    "decision": decision,
                },
            }
        ],
        "tool_call": {
            "action_id": action_id,
            "tool_name": tool_name,
            "tool_version": "kubernetes-audit",
            "invocation_context": invocation_context,
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Import Kubernetes audit-log JSON/JSONL events into compiler artifact schema.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="One-liner: ./import_kubernetes_audit audit.jsonl --policy policy.json | ./compile - --card",
    )
    parser.add_argument("audit_log", help="Kubernetes audit JSON/JSONL file, or - for stdin")
    parser.add_argument("--policy", "-p", help="Optional authorization policy JSON file")
    parser.add_argument("--executed-at", "-t", help="Override event timestamp from evidence")
    parser.add_argument("--action-index", "-i", type=int, default=0, help="Which audit action to compile")
    parser.add_argument("--out", "-o", type=Path, help="Write artifact files to this directory")
    parser.add_argument("--all", "-a", action="store_true", help="Write one artifact directory per audit event")
    args = parser.parse_args()

    events = load_json_or_jsonl(args.audit_log, "Kubernetes audit events", array_key="items")
    policy = load_policy(args.policy)
    action_events = [event for event in events if _is_action_event(event)]
    if not action_events:
        print("ERROR: no action-like Kubernetes audit events found", file=sys.stderr)
        return 1

    indices = list(range(len(action_events))) if args.all else [args.action_index]
    if args.all and not args.out:
        print("ERROR: --all requires --out so each action has a separate artifact directory", file=sys.stderr)
        return 1

    for idx in indices:
        if idx < 0 or idx >= len(action_events):
            print(f"ERROR: action_index {idx} but only {len(action_events)} audit event(s)", file=sys.stderr)
            return 1
        try:
            merged = _event_to_artifacts(action_events[idx], policy, args.executed_at)
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        if args.out:
            out_dir = args.out / f"action_{idx}" if args.all else args.out
            write_artifacts(out_dir, merged)
            print(f"  [{idx}] {merged['tool_call']['tool_name']} -> {out_dir}/", file=sys.stderr)
        else:
            print(json.dumps(merged, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
