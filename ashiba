#!/usr/bin/env python3
"""Ashiba receipt compiler command facade."""

from __future__ import annotations

import argparse
import sys

import receipt_scan


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(prog="ashiba", description=__doc__)
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("scan", help="Scan logs for claim-readiness gaps")
    if not argv:
        parser.print_help()
        return 2
    if argv[0] == "scan":
        return receipt_scan.main(argv[1:])
    parser.parse_args(argv)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
